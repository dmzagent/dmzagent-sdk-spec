{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.dmzagent.com/schemas/outcome-event.json",
  "title": "OutcomeEvent",
  "description": "Webhook payload for per-workspace reasoning outcome events.",
  "type": "object",
  "required": ["frame_id", "workspace_id", "subject_id", "outcome"],
  "properties": {
    "frame_id":       { "type": "string" },
    "workspace_id":   { "type": "string" },
    "subject_id":     { "type": "string" },
    "outcome":        { "type": "string", "enum": ["skipped", "no_change", "applied", "failed"] },
    "tags_fired":     { "type": "array", "items": { "type": "object" } },
    "soul_version":   { "type": "integer" },
    "ledger_index":   { "type": "integer" }
  }
}
