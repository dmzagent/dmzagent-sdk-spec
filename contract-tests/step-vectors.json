    {
      "name": "step_unknown_directive_is_read_as_block",
      "$why": "Appendix B lets the server add a directive. An SDK that did not know it must not let the call run: an unknown word from the governor is not a yes (sdk-spec.md 1.9).",
      "method": "agent_step",
      "args": {
        "agent_subject_id": "subject:dv_test:agent-a",
        "interaction_id": "sess_1",
        "phase": "call",
        "call_id": "call_1",
        "tool": "Bash",
        "args": {
