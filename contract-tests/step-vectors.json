      },
      "responses": [
        {
          "status": 200,
          "body": {
            "frame_id": "fr_1",
            "interaction_id": "sess_1",
            "directive": "quarantine",
            "scope": "subject",
            "reason": "",
            "approval_id": null,
            "settled": true,
            "behaviors": [],
            "anchor": null,
            "livemode": false
          }
        }
      ],
      "expected_request": {
        "method": "POST",
