        "runs": false
      }
    },
    {
      "name": "step_unknown_polarity_is_kept_raw",
      "method": "agent_step",
      "args": {
        "agent_subject_id": "subject:dv_test:agent-a",
        "interaction_id": "sess_1",
        "phase": "call",
        "call_id": "call_1",
        "tool": "Bash",
        "args": {
          "command": "ls"
        }
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "frame_id": "fr_1",
            "interaction_id": "sess_1",
            "directive": "proceed",
            "scope": null,
            "reason": "",
            "approval_id": null,
            "settled": true,
            "behaviors": [
              {
                "tag": "kept-its-word",
                "polarity": "neutral",
                "strength": 0.82,
                "source": "reasoning",
                "evidence": [
                  "fr_0",
                  "fr_1"
                ],
                "calls": [
                  "call_0",
                  "call_1"
                ]
              }
            ],
            "anchor": null,
            "livemode": false
          }
        }
      ],
      "expected_request": {
        "method": "POST",
        "path": "/v1/agent-stream/step"
      },
      "expected_result": {
        "directive": "proceed",
        "runs": true,
        "behaviors": [
          {
            "tag": "kept-its-word",
            "polarity": "neutral"
          }
        ]
      }
    }
  ],
  "failures": [
    {
      "name": "step_unanswered_raises",
      "$why": "An unanswered call step is not a yes. The SDK raises; it never returns a StepResult the caller could read as permission.",
      "method": "agent_step",
      "args": {
        "agent_subject_id": "subject:dv_test:agent-a",
        "interaction_id": "sess_1",
        "phase": "call",
        "call_id": "call_1",
        "tool": "Bash",
        "args": {
          "command": "ls"
        }
      },
      "responses": [
        {
          "status": 503,
          "body": {
            "detail": "unavailable"
          }
        }
      ],
      "expected_exception": "ServerError"
    }
  ]
}
