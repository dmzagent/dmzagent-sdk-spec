{
  "$schema_version": "0.8.1",
  "$description": "Each entry: drive the SDK with `method` + `args`. The resulting POST body MUST equal `expected_body` after JSON normalization (sort keys, no extra whitespace, no trailing newline). Snake_case keys here are canonical wire keys — SDK runners translate args to their idiomatic naming via §8 of sdk-spec.md. Subject ids appear in both documented forms (Appendix A): canonical `subject:<division_id>:<slug>` and its 4-part `subject:<division_id>:<type>:<slug>` variant, plus the deprecated legacy `user:<workspace_id>:<slug>`. Until 0.8.0 every fixture used the legacy form only, so all four SDKs were conformance-tested against the one shape that resolves to no division server-side. Keep at least one canonical fixture per method family.",
  "fixtures": [
    {
      "name": "subject_says_minimal",
      "method": "subject_says",
      "args": {
        "agent_subject_id": "user:ws_test:bot",
        "subject_id": "user:ws_test:cust",
        "subject_type": "sensor",
        "text": "I want a refund."
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "subject_says",
        "agent_subject_id": "user:ws_test:bot",
        "payload": {
          "text": "I want a refund."
        },
        "interaction_kind": "chat_session",
        "speaker_subject_id": "user:ws_test:cust",
        "subject_type": "sensor"
      }
    },
    {
      "name": "subject_says_with_interaction_and_subjects",
      "method": "subject_says",
      "args": {
        "agent_subject_id": "user:ws_test:bot",
        "subject_id": "user:ws_test:cust",
        "subject_type": "sensor",
        "text": "Hi.",
        "interaction_id": "int_abc",
        "subjects": [
          {
            "subject_id": "user:ws_test:bot",
            "role": "agent",
            "kind": "agent"
          },
          {
            "subject_id": "user:ws_test:cust",
            "role": "customer",
            "kind": "human"
          }
        ]
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "subject_says",
        "agent_subject_id": "user:ws_test:bot",
        "payload": {
          "text": "Hi."
        },
        "interaction_id": "int_abc",
        "interaction_kind": "chat_session",
        "speaker_subject_id": "user:ws_test:cust",
        "subject_type": "sensor",
        "subjects": [
          {
            "subject_id": "user:ws_test:bot",
            "role": "agent",
            "kind": "agent"
          },
          {
            "subject_id": "user:ws_test:cust",
            "role": "customer",
            "kind": "human"
          }
        ]
      }
    },
    {
      "name": "subject_says_canonical_subject",
      "method": "subject_says",
      "args": {
        "agent_subject_id": "subject:dv_acme:leasing-bot",
        "subject_id": "subject:dv_acme:customer-anon",
        "subject_type": "chat",
        "text": "I want a refund.",
        "subjects": [
          {
            "subject_id": "subject:dv_acme:leasing-bot",
            "role": "agent",
            "kind": "agent"
          },
          {
            "subject_id": "subject:dv_acme:customer-anon",
            "role": "customer",
            "kind": "human"
          }
        ]
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "subject_says",
        "agent_subject_id": "subject:dv_acme:leasing-bot",
        "payload": {
          "text": "I want a refund."
        },
        "interaction_kind": "chat_session",
        "speaker_subject_id": "subject:dv_acme:customer-anon",
        "subject_type": "chat",
        "subjects": [
          {
            "subject_id": "subject:dv_acme:leasing-bot",
            "role": "agent",
            "kind": "agent"
          },
          {
            "subject_id": "subject:dv_acme:customer-anon",
            "role": "customer",
            "kind": "human"
          }
        ]
      }
    },
    {
      "name": "tool_call_basic",
      "method": "tool_call",
      "args": {
        "subject_id": "user:ws_test:bot",
        "subject_type": "sensor",
        "tool": "refund.issue",
        "args": {
          "amount": 9900,
          "currency": "usd"
        }
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "tool_call",
        "agent_subject_id": "user:ws_test:bot",
        "payload": {
          "tool": "refund.issue",
          "args": {
            "amount": 9900,
            "currency": "usd"
          }
        },
        "interaction_kind": "chat_session",
        "speaker_subject_id": "user:ws_test:bot",
        "speaker_role": "agent",
        "subject_type": "sensor"
      }
    },
    {
      "name": "tool_result_basic",
      "method": "tool_result",
      "args": {
        "subject_id": "user:ws_test:bot",
        "subject_type": "sensor",
        "tool": "refund.issue",
        "result": {
          "refund_id": "re_123",
          "status": "succeeded"
        }
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "tool_result",
        "agent_subject_id": "user:ws_test:bot",
        "payload": {
          "tool": "refund.issue",
          "result": {
            "refund_id": "re_123",
            "status": "succeeded"
          }
        },
        "interaction_kind": "chat_session",
        "speaker_subject_id": "user:ws_test:bot",
        "subject_type": "sensor"
      }
    },
    {
      "name": "observation_basic",
      "method": "observation",
      "args": {
        "agent_subject_id": "user:ws_test:sensor",
        "subject_type": "sensor",
        "subjects": [
          {
            "subject_id": "user:ws_test:sensor",
            "role": "service",
            "kind": "sensor"
          }
        ],
        "payload": {
          "kind": "video_keyframe",
          "frame_index": 42
        }
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "observation",
        "agent_subject_id": "user:ws_test:sensor",
        "payload": {
          "kind": "video_keyframe",
          "frame_index": 42
        },
        "interaction_kind": "chat_session",
        "subject_type": "sensor",
        "subjects": [
          {
            "subject_id": "user:ws_test:sensor",
            "role": "service",
            "kind": "sensor"
          }
        ]
      }
    },
    {
      "name": "observation_canonical_four_part_subject",
      "method": "observation",
      "args": {
        "agent_subject_id": "subject:dv_acme:sensor:door-cam-3",
        "subject_type": "sensor",
        "subjects": [
          {
            "subject_id": "subject:dv_acme:sensor:door-cam-3",
            "role": "service",
            "kind": "sensor"
          }
        ],
        "payload": {
          "kind": "video_keyframe",
          "frame_index": 42
        }
      },
      "expected_path": "/v1/agent-stream/event",
      "expected_body": {
        "kind": "observation",
        "agent_subject_id": "subject:dv_acme:sensor:door-cam-3",
        "payload": {
          "kind": "video_keyframe",
          "frame_index": 42
        },
        "interaction_kind": "chat_session",
        "subject_type": "sensor",
        "subjects": [
          {
            "subject_id": "subject:dv_acme:sensor:door-cam-3",
            "role": "service",
            "kind": "sensor"
          }
        ]
      }
    },
    {
      "name": "check_subject",
      "method": "check",
      "args": {
        "subject_id": "user:ws_test:bot"
      },
      "expected_path": "/v1/cb/check",
      "expected_body": {
        "scope": "subject",
        "scope_ref": "user:ws_test:bot"
      }
    },
    {
      "name": "check_canonical_subject",
      "method": "check",
      "args": {
        "subject_id": "subject:dv_acme:leasing-bot"
      },
      "expected_path": "/v1/cb/check",
      "expected_body": {
        "scope": "subject",
        "scope_ref": "subject:dv_acme:leasing-bot"
      }
    },
    {
      "name": "check_interaction",
      "method": "check",
      "args": {
        "interaction_id": "int_abc"
      },
      "expected_path": "/v1/cb/check",
      "expected_body": {
        "scope": "interaction",
        "scope_ref": "int_abc"
      }
    }
  ],
  "validation_failures": [
    {
      "name": "emit_event_unknown_kind",
      "method": "emit_event",
      "args": {
        "kind": "nonsense",
        "agent_subject_id": "user:ws_test:bot",
        "subject_type": "sensor"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "kind"
    },
    {
      "name": "check_neither_arg",
      "method": "check",
      "args": {},
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "exactly one"
    },
    {
      "name": "check_both_args",
      "method": "check",
      "args": {
        "subject_id": "x",
        "interaction_id": "y"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "exactly one"
    },
    {
      "name": "client_construct_missing_prefix",
      "method": "construct",
      "args": {
        "api_key": "sk_wrong_prefix"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "ck_"
    },
    {
      "name": "client_construct_empty_key",
      "method": "construct",
      "args": {
        "api_key": ""
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "ck_"
    }
  ]
}
