  "validation_failures": [
    {
      "name": "emit_event_unknown_kind",
      "method": "emit_event",
      "args": {
        "kind": "nonsense",
        "agent_subject_id": "user:ws_test:bot",
        "subject_type": "sensor"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "kind"
    },
    {
      "name": "check_neither_arg",
      "method": "check",
      "args": {},
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "exactly one"
    },
    {
      "name": "check_both_args",
      "method": "check",
      "args": {
        "subject_id": "x",
        "interaction_id": "y"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "exactly one"
    },
    {
      "name": "client_construct_missing_prefix",
      "method": "construct",
      "args": {
        "api_key": "sk_wrong_prefix"
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "ck_"
    },
    {
      "name": "client_construct_empty_key",
      "method": "construct",
      "args": {
        "api_key": ""
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "ck_"
    },
    {
      "name": "decide_approval_rejects_missing_actor",
      "method": "decide_approval",
      "args": {
        "approval_id": "apr_7f3c9a1b",
        "decision": "approve",
        "actor_id": ""
      },
      "expected_exception": "ValidationError_or_ArgumentError",
      "expected_message_contains": "actor_id",
      "$why": "A caller with no human's identity at this point does not have a human. Refused locally, with no round trip, so the failure lands where the mistake is (sdk-spec.md 5.18)."
    },
    {
      "name": "decide_approval_rejects_unknown_decision",
      "method": "decide_approval",
      "args": {
        "approval_id": "apr_7f3c9a1b",
