        "attempt_of": "call_7"
      },
      "expected_path": "/v1/agent-stream/step",
      "expected_method": "POST",
      "expected_body": {
        "agent_subject_id": "subject:dv_test:agent-a",
        "interaction_id": "sess_1",
        "phase": "result",
        "call_id": "call_9",
        "tool": "Bash",
        "status": "refused",
        "refused_by": "harness",
